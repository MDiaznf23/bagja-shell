// #######################################################################################
// BAGJA-SHELL NIRI CONFIG (niri 26.04+)
// #######################################################################################

//--------------------
//---- INPUT ----
//--------------------

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
    }

    focus-follows-mouse
}

gestures {
    hot-corners {
        off
    }
}

//--------------------
//---- LAYOUT ----
//--------------------

prefer-no-csd

layout {
    gaps 10
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        off
    }

    // Colors are set in colors_niri.kdl (included below, so it overrides this).
    border {
        on
        width 2
    }

    shadow {
        on
        softness 10
        spread 2
        offset x=0 y=3
        color "#1a1a1aee"
    }
}

// Generated by warnaza / m3wal. Must come AFTER the layout block above:
// includes are positional and override whatever was set before them.
include optional=true "colors_niri.kdl"

//--------------------
//---- GLOBAL WINDOW RULES ----
//--------------------
// Must stay ABOVE the app-specific rules (later rules override earlier ones).

// Ignore apps that ask to open "maximized to edges" (no gap, no border).
// This is what made Brave and kitty open edge-to-edge.
window-rule {
    open-maximized-to-edges false
}

// Rounded corners (Hyprland: rounding = 10)
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

//--------------------
//---- BLUR ----
//--------------------

blur {
    passes 2
    offset 3.0
    noise 0.0117
    saturation 1.0
}

//--------------------
//---- ANIMATIONS ----
//--------------------
// Hyprland's bezier curves are not ported 1:1; these use niri's named curves.

animations {
    window-open {
        duration-ms 300
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

//--------------------
//---- ENVIRONMENT ----
//--------------------

cursor {
    xcursor-size 24
}

environment {
    QT_QPA_PLATFORM "wayland"
    XDG_MENU_PREFIX "arch-"
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/screenshot_%Y%m%d_%H%M%S.png"

//--------------------
//---- AUTOSTART ----
//--------------------
// niri sets WAYLAND_DISPLAY, NIRI_SOCKET and XDG_CURRENT_DESKTOP itself.
// xwayland-satellite is started automatically by niri when an X11 app needs it.

spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORM"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "dex --autostart --environment niri"
spawn-sh-at-startup "~/m3-colors-switch.sh"
spawn-sh-at-startup "awww-daemon"
spawn-sh-at-startup "~/.config/niri/restore-wallpaper.sh"
spawn-at-startup "qs"
spawn-sh-at-startup "kbuildsycoca6 --noincremental"
spawn-sh-at-startup "/usr/bin/kded6"
spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "/usr/lib/pam_kwallet_init"
spawn-sh-at-startup "kwalletd6"

//--------------------
//---- WORKSPACES ----
//--------------------
// Named workspaces persist even when empty, like Hyprland's persistent 1-5.
// Names are "ws1".."ws5" (digit-only names could be confused with indexes).
// Key binds and the shell address workspaces by index, so Mod+1 = first one.

workspace "ws1"
workspace "ws2"
workspace "ws3"
workspace "ws4"
workspace "ws5"

//--------------------
//---- WINDOW RULES ----
//--------------------
// Hyprland "opacity A B" = active / inactive, so each pair becomes two rules.
// Blur is enabled on the same windows (Hyprland blurred translucent windows).

window-rule {
    match app-id=r#"(?i)^code$"# is-active=true
    opacity 0.95
    background-effect { blur true; }
}
window-rule {
    match app-id=r#"(?i)^code$"# is-active=false
    opacity 0.90
    background-effect { blur true; }
}

window-rule {
    match app-id=r#"^org\.kde\.dolphin$"# is-active=true
    opacity 0.92
    background-effect { blur true; }
}
window-rule {
    match app-id=r#"^org\.kde\.dolphin$"# is-active=false
    opacity 0.90
    background-effect { blur true; }
}

window-rule {
    match app-id=r#"(?i)^pcmanfm$"# is-active=true
    match app-id=r#"(?i)^thunar$"# is-active=true
    match app-id=r#"^org\.gnome\.Nautilus$"# is-active=true
    opacity 0.90
    background-effect { blur true; }
}
window-rule {
    match app-id=r#"(?i)^pcmanfm$"# is-active=false
    match app-id=r#"(?i)^thunar$"# is-active=false
    match app-id=r#"^org\.gnome\.Nautilus$"# is-active=false
    opacity 0.85
    background-effect { blur true; }
}

// Floating windows open centered by default in niri.
window-rule {
    match app-id=r#"^viewnior$"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 540; }
}

window-rule {
    match app-id=r#"^org\.kde\.haruna$"#
    match app-id=r#"^mpv$"#
    open-floating true
    default-column-width { fixed 1090; }
    default-window-height { fixed 615; }
}

window-rule {
    match app-id=r#"^org\.kde\.ark$"#
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    open-floating true
    default-column-width { fixed 890; }
    default-window-height { fixed 500; }
}

window-rule {
    match app-id=r#"^com-abdownloadmanager-desktop-AppKt$"#
    match app-id=r#"^wine$"#
    open-floating true
}

window-rule {
    match app-id=r#"^audacious$"#
    open-floating true
    default-column-width { fixed 550; }
    default-window-height { fixed 410; }
}

// Picture-in-picture: small, bottom-right.
// (Hyprland also pinned it; niri has no pin, so it stays on its workspace.)
window-rule {
    match title=r#"(?i)^picture[- ]in[- ]picture$"#
    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

//--------------------
//---- KEYBINDINGS ----
//--------------------
// Mod = Super on a real session (Alt when niri runs nested in another compositor).
// Interactive window move/resize with Mod + mouse drag is built in to niri.

binds {
    // ── Shell (quickshell IPC) ──
    Mod+D       { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Tab     { spawn "qs" "ipc" "call" "workspaceoverview" "toggle"; }
    Mod+L       { spawn "qs" "ipc" "call" "lockscreen" "lock"; }
    Mod+Shift+B { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    Mod+Shift+E { spawn "qs" "ipc" "call" "powermenu" "display"; }
    Mod+C       { spawn-sh "cliphist list | qs ipc call clipboard open"; }

    // ── Programs ──
    Mod+Return  { spawn "kitty"; }
    Mod+B       { spawn "brave"; }
    Mod+Shift+F { spawn "dolphin"; }

    // ── Windows ──
    Mod+Shift+Q { close-window; }
    Mod+F       { fullscreen-window; }          // true fullscreen: no gap, no border
    Mod+M       { maximize-column; }            // full width, gaps kept (press again to undo)
    Mod+Shift+M { maximize-window-to-edges; }   // edge-to-edge, no gap (toggle)
    Mod+J       { switch-preset-column-width; }
    Mod+R       { reset-window-height; }

    // Float + resize + center, and back to tiling
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { move-window-to-tiling; }
    Mod+Alt+V   { switch-focus-between-floating-and-tiling; }

    // ── Focus (niri scrolls columns horizontally, windows stack inside a column) ──
    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }

    // ── Move columns / windows ──
    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }

    // Merge / split windows between neighbouring columns (this is how you stack)
    Mod+Comma   { consume-or-expel-window-left; }
    Mod+Period  { consume-or-expel-window-right; }

    // ── Size ──
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+Ctrl+C  { center-column; }

    // ── Workspaces (niri workspaces are vertical; keys kept from Hyprland) ──
    Mod+Ctrl+Up   { focus-workspace-up; }
    Mod+Ctrl+Down  { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // niri's own overview (the shell's workspace overview is on Mod+Tab)
    Mod+O repeat=false { toggle-overview; }

    // ── Screenshots (same grim/slurp commands as Hyprland) ──
    Print       { spawn-sh "grim ~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png"; }
    Mod+Shift+S { spawn-sh "grim -g \"$(slurp)\" ~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png"; }
    Mod+Shift+C { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }

    // ── Media keys ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+ && qs ipc call osd open"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- && qs ipc call osd open"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+ && qs ipc call osd open"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%- && qs ipc call osd open"; }

    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    // ── Session ──
    Mod+Shift+Slash { show-hotkey-overlay; }
}
